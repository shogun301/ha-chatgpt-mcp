PUBLIC_BASE_URL=https://mcp.example.com
FRONTEND_PUBLIC_URL=https://ha.example.com
MCP_ALLOWED_HOSTS=mcp.example.com
HA_BASE_URL=http://127.0.0.1:8123
MCP_LOCAL_BASE_URL=http://127.0.0.1:8000
LAN_SUBNET=192.0.2.0/24
MCP_DISPLAY_NAME=Home Assistant MCP
OAUTH_SUBJECT=home-assistant-mcp
PRESENCE_ENTITY=person.primary_resident
MOBILE_NOTIFY_SERVICE=mobile_app_primary_phone
DEFAULT_VACUUM_ENTITY=vacuum.primary_vacuum
SPRINKLER_ENTITY_PREFIX=sprinkler_controller
SPRINKLER_ZONE_ENTITY_PREFIX=sprinkler_controller_zone
SPRINKLER_ZONE_COUNT=8
AUTOMATION_DAILY_FORECAST_ENTITY=
LIVING_CLIMATE_ENTITY=climate.living_space_thermostat
LIVING_SCHEDULE_ID=living_space_schedule
LIVING_AUTOMATION_ENTITY=automation.living_space_thermostat_follow_schedule
BEDROOM_CLIMATE_ENTITY=climate.bedroom_thermostat
BEDROOM_SCHEDULE_ID=bedroom_schedule
BEDROOM_AUTOMATION_ENTITY=automation.bedroom_thermostat_follow_schedule
AWAY_AUTOMATION_ENTITY=automation.thermostats_away
SOLAREDGE_REDIRECT_URI=https://mcp.example.com/solaredge/oauth/callback
SOLAREDGE_PORTAL_TIMEZONE=UTC
ACME_EMAIL=admin@example.com
MCP_ORIGIN_HOST=origin.example.com
